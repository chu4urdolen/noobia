# Computer running a supported Codex CLI (for example the friend's Windows PC).
CODEX_HOST=192.168.1.20
CODEX_USER=friend
CODEX_PORT=22

# Command visible to that computer's SSH session.
CODEX_COMMAND=codex

# Optional command prefix. For Windows OpenSSH using cmd.exe, for example:
# CODEX_REMOTE_PREFIX=cd /d C:\\Users\\friend\\Projects &&
CODEX_REMOTE_PREFIX=

# Wisp's dedicated outbound identity.
CODEX_IDENTITY=$HOME/.ssh/wisp_codex_ed25519
