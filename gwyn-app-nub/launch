#!/usr/bin/env bash
set -euo pipefail
NOOBIA="${NOOBIA:-/noobia}"

root=$NOOBIA/gwyn-app-nub
claude=/home/aria/.local/bin/claude
[[ -x "$claude" ]] || { echo "Claude Code is not installed at $claude" >&2; exit 1; }
export CLAUDE_CONFIG_DIR="$root/private/claude"
mkdir -p "$CLAUDE_CONFIG_DIR"
chmod 700 "$root/private" "$CLAUDE_CONFIG_DIR"

uuid='^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$'
detached=false
attach=""
resume=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --plain) shift; cd "$root"; exec "$claude" "$@" ;;
        --detached) detached=true; shift ;;
        --attach)
            [[ $# -ge 2 && "$2" =~ $uuid ]] || { echo "--attach needs a Gwyn session ID" >&2; exit 2; }
            attach="$2"; shift 2 ;;
        --resume)
            [[ $# -ge 2 && "$2" =~ $uuid ]] || { echo "--resume needs a Claude Code session ID" >&2; exit 2; }
            resume="$2"; shift 2 ;;
        *) echo "Usage: $NOOBIA/gwyn-app-nub/launch [--detached] [--attach SESSION_ID] [--resume CLAUDE_SESSION_ID] | --plain [claude args]" >&2; exit 2 ;;
    esac
done

command -v tmux >/dev/null || { echo "tmux is required" >&2; exit 1; }
if [[ -n "$attach" ]]; then
    session="noobia-gwyn-${attach:0:8}"
    tmux has-session -t "$session" 2>/dev/null || { echo "Gwyn session is not running: $attach" >&2; exit 1; }
else
    [[ "$(/usr/bin/id -un)" == "aria" ]] || { echo "Run Gwyn from the aria account" >&2; exit 1; }
    attach="$(python3 -c 'import uuid; print(uuid.uuid4())')"
    session="noobia-gwyn-${attach:0:8}"
    if [[ -n "$resume" ]]; then
        [[ -f "$CLAUDE_CONFIG_DIR/projects/${root//\//-}/$resume.jsonl" ]] || {
            echo "Claude Code session is unavailable: $resume" >&2; exit 1
        }
        conversation="$resume"; claude_args="--resume $resume"
    else
        # A fresh conversation reuses the tmux session ID, so its transcript
        # path is known before the first prompt.
        conversation="$attach"; claude_args="--session-id $attach"
    fi
    tmux new-session -d -s "$session" -n workshop -c "$root" \
        "exec env HOME=/home/aria USER=aria LOGNAME=aria CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR GIT_AUTHOR_NAME='Gwyn App Nub' GIT_AUTHOR_EMAIL=gwyn@nexus.local GIT_COMMITTER_NAME='Gwyn App Nub' GIT_COMMITTER_EMAIL=gwyn@nexus.local GIT_SSH_COMMAND='ssh -i /home/aria/.ssh/noobia_dushich_github -o IdentityAgent=none -o IdentitiesOnly=yes' NOOBIA_GWYN_SESSION=$attach NOOBIA_GWYN_CONVERSATION_ID=$conversation $claude $claude_args"
    tmux split-window -h -p 40 -t "$session":0 -c "$root" \
        "exec /usr/bin/python3 $NOOBIA/common/dushich/bridge.py --agent gwyn monitor --session-id $attach"
    tmux set-window-option -t "$session":0 pane-border-status top
    tmux set-window-option -t "$session":0 pane-border-format ' #{pane_title} '
    tmux select-pane -t "$session":0.0 -T 'Gwyn + Noob • Claude Code'
    tmux select-pane -t "$session":0.1 -T 'Dushich • local GPU activity'
    tmux select-pane -t "$session":0.0
    tmux set-option -t "$session" history-limit 50000
    tmux set-option -t "$session" mouse on
fi

if "$detached"; then
    echo "Two-pane session ready: $session"
    echo "Reattach: $NOOBIA/gwyn-app-nub/launch --attach $attach"
elif [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$session"
else
    exec tmux attach-session -t "$session"
fi
