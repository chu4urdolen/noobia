#!/usr/bin/env bash
set -euo pipefail
NOOBIA="${NOOBIA:-/noobia}"

detached=false
attach=""
conversation=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --detached) detached=true; shift ;;
        --attach)
            [[ $# -ge 2 ]] || { echo "--attach needs a Banshee session ID" >&2; exit 2; }
            attach="$2"; shift 2 ;;
        --conversation)
            [[ $# -ge 2 ]] || { echo "--conversation needs an Antigravity conversation ID" >&2; exit 2; }
            conversation="$2"; shift 2 ;;
        *) echo "Usage: $NOOBIA/banshee/launch [--detached] [--attach SESSION_ID] [--conversation CONVERSATION_ID]" >&2; exit 2 ;;
    esac
done

command -v tmux >/dev/null || { echo "tmux is required" >&2; exit 1; }
if [[ -n "$attach" ]]; then
    [[ "$attach" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] || {
        echo "Invalid Banshee session ID" >&2; exit 2
    }
    session="noobia-banshee-${attach:0:8}"
    tmux has-session -t "$session" 2>/dev/null || {
        echo "Banshee session is not running: $attach" >&2; exit 1
    }
else
    if [[ -n "$conversation" ]]; then
        [[ "$conversation" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] || {
            echo "Invalid Antigravity conversation ID" >&2; exit 2
        }
        [[ -f "$HOME/.gemini/antigravity-cli/conversations/$conversation.db" ]] || {
            echo "Antigravity conversation is unavailable: $conversation" >&2; exit 1
        }
    fi
    attach="$(python3 -c 'import uuid; print(uuid.uuid4())')"
    session="noobia-banshee-${attach:0:8}"
    agy_args="--dangerously-skip-permissions"
    [[ -z "$conversation" ]] || agy_args="$agy_args --conversation $conversation"
    [[ "$(/usr/bin/id -un)" == "aria" ]] || { echo "Run Banshee from the aria account" >&2; exit 1; }
    tmux new-session -d -s "$session" -n workshop -c $NOOBIA/banshee/workspace \
        "exec env HOME=/home/aria USER=aria LOGNAME=aria GIT_AUTHOR_NAME=Banshee GIT_AUTHOR_EMAIL=banshee@nexus.local GIT_COMMITTER_NAME=Banshee GIT_COMMITTER_EMAIL=banshee@nexus.local GIT_SSH_COMMAND='ssh -i /home/aria/.ssh/noobia_dushich_github -o IdentityAgent=none -o IdentitiesOnly=yes' NOOBIA_BANSHEE_SESSION=$attach NOOBIA_BANSHEE_CONVERSATION_ID=$conversation /home/aria/.local/bin/agy $agy_args"
    tmux split-window -h -p 50 -t "$session":0 -c $NOOBIA/banshee \
        "exec /usr/bin/python3 $NOOBIA/common/dushich/bridge.py --agent banshee monitor --session-id $attach"
    tmux set-window-option -t "$session":0 pane-border-status top
    tmux set-window-option -t "$session":0 pane-border-format ' #{pane_title} '
    tmux select-pane -t "$session":0.0 -T 'Banshee + Noob • Antigravity'
    tmux select-pane -t "$session":0.1 -T 'Dushich • local GPU activity'
    tmux select-pane -t "$session":0.0
    tmux set-option -t "$session" history-limit 50000
    tmux set-option -t "$session" mouse on
fi

if "$detached"; then
    echo "Two-pane session ready: $session"
    echo "Reattach: noobia-banshee --attach $attach"
elif [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$session"
else
    exec tmux attach-session -t "$session"
fi
