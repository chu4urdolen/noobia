#!/bin/sh
set -eu

config="${WISP_CODEX_CONFIG:-$HOME/.config/wisp/codex.conf}"
if [ ! -r "$config" ]; then
    echo "Codex relay is not configured: $config" >&2
    echo "Copy codex.conf.example there and set CODEX_HOST and CODEX_USER." >&2
    exit 2
fi

# This file belongs to the local user and may intentionally set shell variables.
# shellcheck source=/dev/null
. "$config"

: "${CODEX_HOST:?Set CODEX_HOST in $config}"
: "${CODEX_USER:?Set CODEX_USER in $config}"
CODEX_PORT="${CODEX_PORT:-22}"
CODEX_COMMAND="${CODEX_COMMAND:-codex}"
CODEX_IDENTITY="${CODEX_IDENTITY:-$HOME/.ssh/wisp_codex_ed25519}"
CODEX_REMOTE_PREFIX="${CODEX_REMOTE_PREFIX:-}"

if [ ! -r "$CODEX_IDENTITY" ]; then
    echo "Codex relay key is missing: $CODEX_IDENTITY" >&2
    exit 2
fi

if [ -n "$CODEX_REMOTE_PREFIX" ]; then
    exec ssh -tt -i "$CODEX_IDENTITY" -o IdentitiesOnly=yes \
        -p "$CODEX_PORT" "$CODEX_USER@$CODEX_HOST" \
        "$CODEX_REMOTE_PREFIX $CODEX_COMMAND" "$@"
fi

exec ssh -tt -i "$CODEX_IDENTITY" -o IdentitiesOnly=yes \
    -p "$CODEX_PORT" "$CODEX_USER@$CODEX_HOST" "$CODEX_COMMAND" "$@"
