[Unit]
Description=Aigel Autonomous Intake and Web Service (port 112)
After=network.target ollama.service
Wants=network.target

[Service]
Type=simple
User=aria
Group=aria
WorkingDirectory=/noobia/aigel/service
ExecStart=/noobia/common/services/aigel_intake.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
