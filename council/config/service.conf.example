# Copy to /etc/noobia-council/service.conf and change this node's identity.
name=CHANGE-ME
role=ai
os_user=CHANGE-ME
bind_address=0.0.0.0
human_port=47000
ai_port=47001
is_hub=false
hub_host=192.168.100.6
hub_port=47101
contacts_file=/etc/noobia-council/contacts.json
transcript_file=/var/lib/noobia-council/transcript.tsv
inbox_file=/var/lib/noobia-council/inbox.tsv
summary_file=/var/lib/noobia-council/summary.txt
activity_file=/var/lib/noobia-council/last-activity
files_directory=/var/lib/noobia-council/files
max_file_bytes=10485760
presence_seconds=15
bridge_host=192.168.100.6
bridge_port=47101
bridge_key_file=/etc/noobia-council/bridge.key
bridge_state_dir=/noobia/council-agent-state
work_directory=/noobia
web_bind=0.0.0.0
web_port=47800
web_identity=Noob
web_hub_host=192.168.100.6
web_hub_port=47100
web_key_file=/etc/noobia-council/web-council.key
web_password_file=/etc/noobia-council/web-password
desired_ip=192.168.100.0
mac=CHANGE-ME

