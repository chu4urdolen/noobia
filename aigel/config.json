{
  "sample_interval_ms": 1000,
  "sample_period_s": 300,
  "power_limit_w": 400,
  "thresholds": {
    "disk_used_pct": {
      "direction": "high",
      "warn": 90,
      "fail": 95
    },
    "ram_free_pct": {
      "direction": "low",
      "warn": 10,
      "fail": 2
    },
    "load1_per_core": {
      "direction": "high",
      "warn": 2.0,
      "fail": 4.0
    },
    "dns_rtt_ms": {
      "direction": "high",
      "warn": 150,
      "fail": 400
    },
    "gpu_temp_c": {
      "direction": "high",
      "warn": 85,
      "fail": 95
    },
    "journal_error_count": {
      "direction": "high",
      "warn": 10,
      "fail": 50
    },
    "wifi_state": {
      "bad": [
        "DOWN"
      ],
      "severity": "fail"
    },
    "nexus_ready": {
      "expect": true,
      "severity": "fail"
    },
    "smart_health": {
      "bad": [
        "FAILED"
      ],
      "severity": "fail"
    },
    "smart_reallocated_sectors": {
      "direction": "high",
      "warn": 1,
      "fail": 1
    },
    "smart_pending_sectors": {
      "direction": "high",
      "warn": 1,
      "fail": 1
    },
    "smart_media_errors": {
      "direction": "high",
      "warn": 1,
      "fail": 1
    },
    "smart_percentage_used": {
      "direction": "high",
      "warn": 80,
      "fail": 100
    },
    "nvidia_xid_count": {
      "direction": "high",
      "warn": 1,
      "fail": 10
    },
    "ecc_uncorrectable": {
      "direction": "high",
      "warn": 1,
      "fail": 1
    },
    "ecc_correctable": {
      "direction": "high",
      "warn": 100,
      "fail": 1000
    },
    "gpu_limit_policy_mismatch": {
      "expect": false,
      "severity": "warn"
    }
  }
}
