#!/usr/bin/env bash
# Run forge_db.py with the forge venv (meaning search) when it is built.
here="$(dirname "$(readlink -f "$0")")"
runtime="$here/../runtime"
py="$runtime/forge-venv/bin/python"
[[ -x "$py" ]] || py=/usr/bin/python3
# Once the embedding model is cached, never reach the network for it.
[[ -d "$runtime/models" && -n "$(ls -A "$runtime/models" 2>/dev/null)" ]] && export HF_HUB_OFFLINE=1
exec "$py" "$here/forge_db.py" "$@"
