[Unit]
Description=Noobia Council communications service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=noobia-council
Group=noobia-council
WorkingDirectory=/var/lib/noobia-council
ExecStart=/usr/local/bin/noobia-council --config /etc/noobia-council/service.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/noobia-council

[Install]
WantedBy=multi-user.target
