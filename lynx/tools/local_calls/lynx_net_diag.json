{
  "name": "lynx_net_diag",
  "description": "Entity: Lynx. Network diagnostic toolkit (Pwnphone tools): wifi-recon, lan-sweep, port-scan, dns-audit, traceroute, packet-sample.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": ["wifi-recon", "lan-sweep", "port-scan", "dns-audit", "traceroute", "packet-sample"],
        "description": "Diagnostic action to execute"
      },
      "target": {
        "type": "string",
        "description": "Target IP or hostname (for port-scan or traceroute)"
      },
      "ports": {
        "type": "string",
        "description": "Comma-separated ports for port-scan (default: 22,80,443,112,5050,8080,11434)"
      },
      "domain": {
        "type": "string",
        "description": "Domain name for dns-audit (default: google.com)"
      },
      "count": {
        "type": "integer",
        "description": "Number of packets for packet-sample (default: 10)"
      }
    },
    "required": ["action"],
    "additionalProperties": false
  },
  "timeout": 20
}
