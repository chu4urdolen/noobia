#pragma once

// Copy to lolth_wifi.local.h and fill in the LAN credentials. The local file
// is ignored by Git and is compiled into Lolth's firmware.
namespace LolthWifi {
constexpr char SSID[] = "your-network-name";
constexpr char PASSWORD[] = "your-network-password";
// Pick an unused address outside this router's DHCP pool, and set its gateway.
constexpr uint8_t STATIC_IP[4] = {192, 168, 100, 50};
constexpr uint8_t GATEWAY[4] = {192, 168, 100, 1};
constexpr uint8_t SUBNET[4] = {255, 255, 255, 0};
}
