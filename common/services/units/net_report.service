[Unit]
Description=Aigel Network health service – interface stats, active connections, DNS latency
After=network.target

[Service]
Type=simple
ExecStart=/noobia/common/services/net_report.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
