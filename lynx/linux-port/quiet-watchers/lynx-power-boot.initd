#!/sbin/openrc-run
# Every boot starts in power saving (Tom, 2026-11-23): the display shows one
# START button, and lynx-power-mode starts Lynx's services when it is tapped.
# Writes the mode only; never stops, reboots or powers anything off.
description="Lynx boots into power saving (START screen)"

depend() {
    after lynx-local-logs
    before lynx-display
}

start() {
    ebegin "Lynx power mode: saving (boot)"
    mkdir -p /var/lib/noobia
    printf 'saving boot\n' > /var/lib/noobia/power-mode.tmp && mv /var/lib/noobia/power-mode.tmp /var/lib/noobia/power-mode
    eend $?
}
