#!/sbin/openrc-run
# Boot power mode (Tom, 2026-11-23): power saving with one START button, unless
# Lynx's own services are enabled in the default runlevel - then active.
# Writes the mode only; never stops, reboots or powers anything off.
description="Lynx boots into power saving (START screen)"

depend() {
    after lynx-local-logs
    before lynx-display
}

start() {
    # The screen tells the truth (Gwyn 2026-11-25): if Lynx's own services are
    # enabled at boot, she boots active (HOME); otherwise power saving (START).
    mode="saving boot"
    for svc in lynx-senses noobia-autonomyd lynx-agent-worker; do
        [ -e "/etc/runlevels/default/$svc" ] && mode="active"
    done
    ebegin "Lynx power mode: $mode (boot)"
    mkdir -p /var/lib/noobia
    printf '%s\n' "$mode" > /var/lib/noobia/power-mode.tmp && mv /var/lib/noobia/power-mode.tmp /var/lib/noobia/power-mode
    eend $?
}
