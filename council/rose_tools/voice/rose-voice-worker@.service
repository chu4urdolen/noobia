[Unit]
Description=Rose distributed voice worker (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=%h/.local/bin/rose-voice-worker-launch %i
Restart=on-failure
RestartSec=3s
WatchdogSec=30s
Environment=ROSE_STAGE_TIMEOUT_SECONDS=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=default.target
