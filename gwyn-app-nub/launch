#!/usr/bin/env bash
set -euo pipefail

root=/noobia/gwyn-app-nub
claude=/home/aria/.local/bin/claude
[[ -x "$claude" ]] || { echo "Claude Code is not installed at $claude" >&2; exit 1; }
export CLAUDE_CONFIG_DIR="$root/private/claude"
mkdir -p "$CLAUDE_CONFIG_DIR"
chmod 700 "$root/private" "$CLAUDE_CONFIG_DIR"
cd "$root/workspace"
exec "$claude" "$@"
