[Unit]
Description=Aigel CPU health service – per-core usage sample with top snapshot
After=network.target

[Service]
Type=simple
ExecStart=/noobia/common/services/cpu_report.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
