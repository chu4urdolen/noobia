#!/usr/bin/env bash
set -euo pipefail
NOOBIA="${NOOBIA:-/noobia}"

detached=false
resume_id=""
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        --detached)
            detached=true
            shift
            ;;
        --resume)
            if [[ "$#" -lt 2 ]]; then
                echo "--resume needs a Codex session ID" >&2
                exit 2
            fi
            resume_id="$2"
            shift 2
            ;;
        *)
            echo "Usage: noobia-codex [--detached] [--resume SESSION_ID]" >&2
            exit 2
            ;;
    esac
done
if [[ -n "$resume_id" && ! "$resume_id" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]]; then
    echo "Invalid Codex session ID" >&2
    exit 2
fi

if ! command -v tmux >/dev/null 2>&1; then
    echo "tmux is required for the two-pane interface" >&2
    exit 1
fi
if [[ -n "$resume_id" ]]; then
    session="noobia-aria-$resume_id"
else
    for old in $(tmux list-sessions -F '#{session_name}:#{session_attached}' 2>/dev/null || true); do
        if [[ "$old" == noobia-aria-*:0 ]]; then
            tmux kill-session -t "${old%:0}" 2>/dev/null || true
        fi
    done
    session="noobia-aria-$(date -u +%Y%m%dT%H%M%S)-$$"
fi
# Auto-dismiss pending Codex update prompts so unattended/forge starts don't block
if [[ -f "$HOME/.codex/version.json" ]]; then
    python3 -c '
import json, pathlib
p = pathlib.Path.home() / ".codex/version.json"
try:
    data = json.loads(p.read_text(encoding="utf-8"))
    latest = data.get("latest_version")
    if latest and data.get("dismissed_version") != latest:
        data["dismissed_version"] = latest
        p.write_text(json.dumps(data) + "\n", encoding="utf-8")
except Exception:
    pass
' 2>/dev/null || true
fi

codex_bin=""
for candidate in /usr/local/bin/codex $HOME/.local/bin/codex $(command -v codex 2>/dev/null); do
    if [[ -x "$candidate" ]] && "$candidate" --version >/dev/null 2>&1; then
        codex_bin="$candidate"
        break
    fi
done
if [[ -z "$codex_bin" ]]; then
    echo "Working Codex executable not found" >&2
    exit 1
fi

aria_command="exec $codex_bin --no-alt-screen"
if [[ -n "$resume_id" ]]; then
    aria_command="exec $codex_bin --no-alt-screen -c 'mcp_servers.dushich.args=[\"--session-id\",\"$resume_id\"]' resume $resume_id"
fi
if ! tmux has-session -t "$session" 2>/dev/null; then
    tmux new-session -d -s "$session" -n workshop -c $NOOBIA \
        "$aria_command"
    sleep 0.3
    if ! tmux has-session -t "$session" 2>/dev/null; then
        echo "Aria session failed to start in tmux" >&2
        exit 1
    fi
    if [[ -z "$resume_id" ]]; then
        if resume_id="$($NOOBIA/aria/codex-pane-session.py "$session" 2>/dev/null)" && [[ -n "$resume_id" ]]; then
            if tmux has-session -t "$session" 2>/dev/null; then
                tmux rename-session -t "$session" "noobia-aria-$resume_id"
                session="noobia-aria-$resume_id"
            fi
        else
            resume_id=""
        fi
    fi
    if ! tmux has-session -t "$session" 2>/dev/null; then
        echo "Aria session lost during startup" >&2
        exit 1
    fi
    if [[ -n "$resume_id" ]]; then
        monitor_command="exec $NOOBIA/aria/dushich-bridge monitor --full --session-id $resume_id"
    else
        monitor_command="exec $NOOBIA/aria/dushich-bridge monitor --full"
    fi
    tmux split-window -h -p 50 -t "$session":0 -c $NOOBIA \
        "$monitor_command"
    tmux set-window-option -t "$session":0 pane-border-status top
    tmux set-window-option -t "$session":0 pane-border-format ' #{pane_title} '
    tmux set-option -t "$session" history-limit 50000
    tmux select-pane -t "$session":0.0 -T 'Aria + Noob • Codex'
    tmux select-pane -t "$session":0.1 -T 'Dushich • live activity'
    tmux select-pane -t "$session":0.0
    tmux set-option -t "$session" mouse on
elif [[ -n "$resume_id" ]]; then
    # A session can survive after its Codex pane exits because the Dushich
    # monitor is still running. Recreate the missing coding pane in place.
    if ! tmux list-panes -t "$session":0 -F '#{pane_current_command}' | rg -qx 'codex'; then
        tmux split-window -h -b -p 50 -t "$session":0.0 -c $NOOBIA \
            "$aria_command"
        tmux select-pane -t "$session":0.0 -T 'Aria + Noob • Codex'
        tmux select-pane -t "$session":0.0
    fi
    if [[ $(tmux list-panes -t "$session":0 2>/dev/null | wc -l) -lt 2 ]]; then
        tmux split-window -h -p 50 -t "$session":0 -c $NOOBIA \
            "/bin/bash -c 'while true; do $monitor_command; sleep 1; done'"
        tmux set-window-option -t "$session":0 pane-border-status top
        tmux set-window-option -t "$session":0 pane-border-format ' #{pane_title} '
        tmux select-pane -t "$session":0.0 -T 'Aria + Noob • Codex'
        tmux select-pane -t "$session":0.1 -T 'Dushich • live activity'
        tmux select-pane -t "$session":0.0
    fi
fi

if "$detached"; then
    echo "Two-pane session ready: $session"
elif [[ -z "${NOOBIA_ARIA_NO_GUI:-}" && ( -n "${DISPLAY:-}" || -n "${WAYLAND_DISPLAY:-}" || -S "/run/user/$(id -u)/wayland-0" ) ]]; then
    /usr/bin/python3 $NOOBIA/common/nexus_forge/dushich_window.py \
        --agent Aria \
        --tmux-socket default \
        --target-pane "${session}:0.0" \
        --sidebar-width 180 \
        --title "Aria + Dushich • Codex" \
        --command /usr/bin/tmux attach-session -t "$session" || true
    tmux kill-session -t "$session" 2>/dev/null || true
    exit 0
elif [[ -n "${TMUX:-}" ]]; then
    exec tmux switch-client -t "$session"
else
    exec tmux attach-session -t "$session"
fi
