[Unit]
Description=Passive Lynx USB and low-duty Wi-Fi/Bluetooth presence monitor
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /noobia/lynx/tools/lynx_presence.py --interval 30
WorkingDirectory=/noobia/lynx
Restart=on-failure
RestartSec=15
Nice=10
NoNewPrivileges=yes

[Install]
WantedBy=default.target
