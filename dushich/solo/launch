#!/usr/bin/env python3
"""Start or resume Dushich's own local Codex terminal in tmux."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import time
from uuid import uuid4

NOOBIA = os.environ.get("NOOBIA", "/noobia")

UUID = re.compile(r'^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$')
PREFIX = 'noobia-dushich-solo-'
REGISTRY = Path(NOOBIA + '/dushich/solo/private/conversations.json')
LOG = Path(NOOBIA + '/dushich/solo/private/launch.log')
# A cold boot (GPU loading, Codex refreshing plugins) can take far longer than a warm start.
START_TIMEOUT = float(os.environ.get('NOOBIA_DUSHICH_START_TIMEOUT', '120'))
FAILED_MARK = 'Solo Codex failed to start'


def log(message: str) -> None:
    """Append one line to the private launch log; never let logging break a launch."""
    try:
        LOG.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        with LOG.open('a', encoding='utf-8') as stream:
            stream.write(time.strftime('%Y-%m-%dT%H:%M:%S%z ') + message.replace('\n', ' | ') + '\n')
    except OSError:
        pass


def alive(session: str) -> bool:
    return run('tmux', '-L', 'dushich-clean', 'has-session', '-t', session, check=False).returncode == 0


def solo_command(*extra: str) -> str:
    """Pane command: on failure keep the error on screen so the launcher can read and report it."""
    tail = ' '.join(extra)
    return (f'{NOOBIA}/dushich/solo/codex-solo {tail} || {{ c=$?; '
            f"printf '\\n{FAILED_MARK} (exit %s).\\n' \"$c\"; sleep 120; exit \"$c\"; }}")


def registered() -> list[str]:
    try:
        value = json.loads(REGISTRY.read_text(encoding='utf-8'))
    except FileNotFoundError:
        return []
    if not isinstance(value, list):
        raise RuntimeError('Invalid solo Dushich registry')
    return [item for item in value if isinstance(item, str) and UUID.fullmatch(item)]


def register(ident: str) -> None:
    REGISTRY.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(REGISTRY.parent, 0o700)
    ids = registered()
    if ident not in ids:
        ids.append(ident)
    temporary = REGISTRY.with_suffix('.tmp')
    temporary.write_text(json.dumps(ids, indent=2) + '\n', encoding='utf-8')
    os.chmod(temporary, 0o600)
    temporary.replace(REGISTRY)


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, capture_output=True, text=True, check=check)


def capture(session: str) -> str:
    return run('tmux', '-L', 'dushich-clean', 'capture-pane', '-p', '-J', '-S', '-100', '-t', session + ':0.0').stdout


def screen_id(screen: str) -> str | None:
    if 'Session:' not in screen:
        return None
    tail = screen.rsplit('Session:', 1)[1]
    pieces = []
    for line in tail.splitlines():
        part = line.strip()
        if not part:
            continue
        if not re.fullmatch(r'[0-9a-f-]+', part):
            if pieces:
                break
            continue
        pieces.append(part)
        candidate = ''.join(pieces)
        if UUID.fullmatch(candidate):
            return candidate
        if len(candidate) >= 36:
            break
    return None


def wait_for_id(session: str) -> str:
    deadline = time.monotonic() + START_TIMEOUT
    while time.monotonic() < deadline:
        try:
            screen = capture(session)
        except subprocess.CalledProcessError:
            if not alive(session):
                raise RuntimeError('Solo Codex session vanished during startup')
            time.sleep(.2)
            continue
        if FAILED_MARK in screen:
            last = ' | '.join(line for line in screen.strip().splitlines()[-6:] if line.strip())
            raise RuntimeError('codex-solo failed: ' + last)
        if 'Ask Codex to do anything' in screen:
            break
        if 'Update available' in screen:
            run('tmux', '-L', 'dushich-clean', 'send-keys', '-t', session + ':0.0', 'Escape', check=False)
            time.sleep(.4)
            continue
        time.sleep(.2)
    else:
        raise TimeoutError(f'Dushich prompt did not appear within {START_TIMEOUT:.0f}s')
    run('tmux', '-L', 'dushich-clean', 'send-keys', '-l', '-t', session + ':0.0', '--', '/status')
    time.sleep(.2)
    for _ in range(2):
        run('tmux', '-L', 'dushich-clean', 'send-keys', '-t', session + ':0.0', 'Enter')
        until = time.monotonic() + 3
        while time.monotonic() < until:
            found = screen_id(capture(session))
            if found:
                run('tmux', '-L', 'dushich-clean', 'send-keys', '-t', session + ':0.0', 'Escape')
                return found
            time.sleep(.2)
    raise RuntimeError('Could not read Dushich session ID from /status')


def ensure_avatar_pane(session: str) -> None:
    panes = run('tmux', '-L', 'dushich-clean', 'list-panes', '-t', session + ':0',
                '-F', '#{pane_index}', check=False).stdout.splitlines()
    if len(panes) < 2:
        run('tmux', '-L', 'dushich-clean', 'split-window', '-h', '-l', '30',
            '-t', session + ':0.0', '-c', NOOBIA,
            f'exec /usr/bin/python3 {NOOBIA}/common/nexus_forge/avatar_pane.py --agent Dushich --tmux-socket dushich-clean --target-pane {session}:0.0 --size 28')
        run('tmux', '-L', 'dushich-clean', 'set-window-option', '-t', session + ':0', 'pane-border-status', 'top')
        run('tmux', '-L', 'dushich-clean', 'set-window-option', '-t', session + ':0', 'pane-border-format', ' #{pane_title} ')
        run('tmux', '-L', 'dushich-clean', 'select-pane', '-t', session + ':0.0', '-T', 'Solo Dushich • Codex')
        run('tmux', '-L', 'dushich-clean', 'select-pane', '-t', session + ':0.1', '-T', 'Dushich • Status')
        run('tmux', '-L', 'dushich-clean', 'select-pane', '-t', session + ':0.0')


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument('--detached', action='store_true')
    parser.add_argument('--no-gui', action='store_true', help='Do not launch GUI window')
    parser.add_argument('--resume')
    parser.add_argument('--attach')
    args = parser.parse_args()
    if args.resume and args.attach:
        parser.error('--resume and --attach cannot be combined')
    for ident in (args.resume, args.attach):
        if ident and not UUID.fullmatch(ident):
            parser.error('invalid Dushich conversation ID')
    no_gui = args.no_gui or bool(os.environ.get('NOOBIA_DUSHICH_NO_GUI'))
    if args.attach:
        session = PREFIX + args.attach
        if run('tmux', '-L', 'dushich-clean', 'has-session', '-t', session, check=False).returncode:
            parser.error('Dushich session is not running')
        if not no_gui:
            ensure_avatar_pane(session)
    elif args.resume:
        if args.resume not in registered():
            parser.error('conversation is not registered as a solo Dushich session')
        session = PREFIX + args.resume
        if run('tmux', '-L', 'dushich-clean', 'has-session', '-t', session, check=False).returncode:
            run('tmux', '-L', 'dushich-clean', 'new-session', '-d', '-s', session, '-n', 'workshop',
                '-c', NOOBIA, solo_command('resume', args.resume))
        if not no_gui:
            ensure_avatar_pane(session)
    else:
        session = PREFIX + uuid4().hex[:8]
        run('tmux', '-L', 'dushich-clean', 'new-session', '-d', '-s', session, '-n', 'workshop',
            '-c', NOOBIA, solo_command())
        try:
            ident = wait_for_id(session)
            named = PREFIX + ident
            run('tmux', '-L', 'dushich-clean', 'rename-session', '-t', session, named)
            session = named
            register(ident)
            log('started ' + session)
        except TimeoutError as exc:
            # Codex is running but slow or showing a dialog: keep it rather than
            # killing a live mind. The session stays usable, just unregistered.
            if not alive(session):
                log(f'failed: {exc}; session gone')
                raise RuntimeError(str(exc)) from exc
            log(f'kept {session} unregistered: {exc}')
            print(f'Solo Dushich launcher: {exc}; keeping {session} open (not registered for --resume)',
                  file=sys.stderr)
        except Exception as exc:
            log(f'failed: {exc}')
            run('tmux', '-L', 'dushich-clean', 'kill-session', '-t', session, check=False)
            raise
        if not no_gui:
            ensure_avatar_pane(session)
    if args.detached:
        print('Solo Dushich session ready: ' + session)
        ident = session.removeprefix(PREFIX)
        print(f'Reattach: {NOOBIA}/dushich/solo/launch --attach {ident}' if UUID.fullmatch(ident)
              else f'Reattach: tmux -L dushich-clean attach-session -t {session}')
    elif not no_gui and (os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY')
          or Path(f'/run/user/{os.getuid()}/wayland-0').exists()):
        run('tmux', '-L', 'dushich-clean', 'kill-pane', '-t', session + ':0.1', check=False)
        run('tmux', '-L', 'dushich-clean', 'set-option', '-t', session, 'status', 'off', check=False)
        run('tmux', '-L', 'dushich-clean', 'set-window-option', '-t', session + ':0', 'pane-border-status', 'off', check=False)
        os.execvp('/usr/bin/python3', [
            '/usr/bin/python3', NOOBIA + "/common/nexus_forge/dushich_window.py",
            '--agent', 'Dushich', '--tmux-socket', 'dushich-clean',
            '--target-pane', f'{session}:0.0', '--sidebar-width', '180',
            '--title', f'Solo Dushich ({session.removeprefix(PREFIX)[:8]})',
            '--command', 'tmux', '-L', 'dushich-clean', 'attach-session', '-t', session,
        ])
    elif os.environ.get('TMUX'):
        if no_gui:
            run('tmux', '-L', 'dushich-clean', 'kill-pane', '-t', session + ':0.1', check=False)
        os.execvp('tmux', ['tmux', '-L', 'dushich-clean', 'switch-client', '-t', session])
    else:
        if no_gui:
            run('tmux', '-L', 'dushich-clean', 'kill-pane', '-t', session + ':0.1', check=False)
        os.execvp('tmux', ['tmux', '-L', 'dushich-clean', 'attach-session', '-t', session])
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (RuntimeError, subprocess.CalledProcessError) as exc:
        print(f'Solo Dushich launcher: {exc}', file=sys.stderr)
        raise SystemExit(1)
