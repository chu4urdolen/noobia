[Unit]
Description=Aigel GPU monitor service – power, utilization, temperature, VRAM and shutdown events
After=network.target

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'mkdir -p /var/log/noobia_gpu || true'
ExecStart=/noobia/common/services/gpu_monitor.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
