#!/sbin/openrc-run
# Lynx senses (S2 touch, S3 wifi, S4 power, S8 nexus) - sampled loop.
#
# Source of record: lynx/senses/init/lynx-senses.initd (Dushich, 2026-11-21).
# Install belongs to IS-2 (Aria); this file is NOT installed by itself.
# Depends on the autonomy install (IS-2): the canonical sense formatter
# under /usr/local/lib/noobia/autonomy and the senses under
# /usr/local/lib/noobia/senses/ (see lynx/senses/README.md).
#
# Senses write to syslog under the noobia-sense ident (I-2 raises the
# logger to -l 6 so notice lines are kept). Loop errors go to the
# error log; sense lines never do (they are syslog, by design).

name="lynx-senses"
description="Sampled sense emitters for the Noobia autonomy harness"
supervisor="supervise-daemon"

command="/usr/bin/python3"
command_args="/usr/local/lib/noobia/senses/common/lynx_senses_loop.py"
pidfile="/run/lynx/lynx-senses.pid"
output_log="/var/log/lynx-senses.log"
error_log="/var/log/lynx-senses.log"
respawn_delay=2
respawn_max=3
respawn_period=600

depend() {
	after lynx-local-logs lynx-wifi
	need lynx-local-logs
}

start_pre() {
	if [ ! -f "/usr/local/lib/noobia/senses/common/lynx_senses_loop.py" ]; then
		eerror "senses loop missing"
		return 1
	fi
	if [ ! -f "/usr/local/lib/noobia/autonomy/sense.py" ]; then
		eerror "autonomy sense.py missing"
		return 1
	fi
	mkdir -p /run/lynx /var/lib/noobia/senses
}

stop_pre() {
	true
}
