struct codex_job{char prompt[32768];struct codex_config c;};
static void*codex_worker(void*arg){struct codex_job*j=arg;int in[2],out[2];if(pipe(in)||pipe(out))goto end;pid_t p=fork();if(p==0){dup2(in[0],0);dup2(out[1],1);dup2(out[1],2);close(in[1]);close(out[0]);char port[16],dest[400],remote[PATH_MAX+512],key[PATH_MAX];snprintf(port,sizeof port,"%d",j->c.port);snprintf(dest,sizeof dest,"%s@%s",j->c.user,j->c.host);snprintf(key,sizeof key,"%s/.ssh/wisp_codex_ed25519",getenv("HOME"));if(j->c.workdir[0])snprintf(remote,sizeof remote,"%s exec --json --skip-git-repo-check -C \"%s\" -",j->c.command,j->c.workdir);else snprintf(remote,sizeof remote,"%s exec --json --skip-git-repo-check -",j->c.command);execlp("ssh","ssh","-i",key,"-o","IdentitiesOnly=yes","-o","BatchMode=yes","-o","ConnectTimeout=8","-p",port,dest,remote,(char*)NULL);_exit(127);}codex_pid=p;close(in[0]);close(out[1]);write_all(in[1],j->prompt,strlen(j->prompt));close(in[1]);unsigned char b[4096];ssize_t n;while((n=read(out[0],b,sizeof b))>0){pthread_mutex_lock(&codex_lock);size_t add=(size_t)n;if(add>CODEX_OUTPUT_MAX)add=CODEX_OUTPUT_MAX;if(codex_output_len+add>CODEX_OUTPUT_MAX){size_t d=codex_output_len+add-CODEX_OUTPUT_MAX;memmove(codex_output,codex_output+d,codex_output_len-d);codex_output_len-=d;}memcpy(codex_output+codex_output_len,b,add);codex_output_len+=add;pthread_mutex_unlock(&codex_lock);}close(out[0]);waitpid(p,NULL,0);end:free(j);pthread_mutex_lock(&codex_lock);codex_running=false;codex_pid=-1;pthread_mutex_unlock(&codex_lock);return NULL;}
static void codex_run(int fd,const char*body){size_t n;char*p=json_string(body,"prompt",&n);if(!p||!n||n>=32768){free(p);json_error(fd,400,"prompt must be 1 to 32767 bytes");return;}struct codex_job*j=calloc(1,sizeof*j);if(!j||codex_load(&j->c)<0){free(p);free(j);json_error(fd,409,"configure Codex first");return;}pthread_mutex_lock(&codex_lock);if(codex_running){pthread_mutex_unlock(&codex_lock);free(p);free(j);json_error(fd,409,"Codex is already running");return;}codex_running=true;codex_output_len=0;snprintf(j->prompt,sizeof j->prompt,"%s",p);pthread_mutex_unlock(&codex_lock);free(p);pthread_t t;if(pthread_create(&t,NULL,codex_worker,j)){codex_running=false;free(j);json_error(fd,500,"could not start Codex");return;}pthread_detach(t);const char*y="{\"ok\":true}\n";reply(fd,200,"application/json",NULL,y,strlen(y));}
static void codex_result(int fd){pthread_mutex_lock(&codex_lock);size_t ql;char*q=json_quote(codex_output,codex_output_len,&ql);bool run=codex_running;pthread_mutex_unlock(&codex_lock);size_t cap=ql+80;char*b=malloc(cap);int n=snprintf(b,cap,"{\"ok\":true,\"running\":%s,\"output\":%s}\n",run?"true":"false",q);free(q);reply(fd,200,"application/json",NULL,b,(size_t)n);free(b);}
