struct codex_config { char host[256], user[128], command[128], workdir[PATH_MAX]; int port; };
static bool codex_atom(const char *s) { if(!s||!*s)return false; for(;*s;s++)if(!isalnum((unsigned char)*s)&&!strchr("._-:@[]",*s))return false; return true; }
static bool codex_path_ok(const char *s) { if(!s)return false; for(;*s;s++)if((unsigned char)*s<32||strchr("\"'`$;&|<>\r\n",*s))return false; return true; }
static int codex_path(char out[PATH_MAX],const char *file){const char *h=getenv("HOME");return h&&snprintf(out,PATH_MAX,"%s/.config/wisp/%s",h,file)<PATH_MAX?0:-1;}
static int codex_load(struct codex_config *c){memset(c,0,sizeof *c);c->port=22;strcpy(c->command,"codex");char p[PATH_MAX],line[PATH_MAX+32];if(codex_path(p,"codex-web.conf")<0)return-1;FILE*f=fopen(p,"r");if(!f)return-1;while(fgets(line,sizeof line,f)){char*n=strpbrk(line,"\r\n");if(n)*n=0;char*e=strchr(line,'=');if(!e)continue;*e++=0;if(!strcmp(line,"host"))snprintf(c->host,sizeof c->host,"%s",e);else if(!strcmp(line,"user"))snprintf(c->user,sizeof c->user,"%s",e);else if(!strcmp(line,"port"))c->port=atoi(e);else if(!strcmp(line,"command"))snprintf(c->command,sizeof c->command,"%s",e);else if(!strcmp(line,"workdir"))snprintf(c->workdir,sizeof c->workdir,"%s",e);}fclose(f);return codex_atom(c->host)&&codex_atom(c->user)&&c->port>0&&c->port<65536&&codex_atom(c->command)&&codex_path_ok(c->workdir)?0:-1;}
static void codex_status(int fd){struct codex_config c;bool ok=codex_load(&c)==0;char kp[PATH_MAX],pub[1024]="";codex_path(kp,"../../.ssh/wisp_codex_ed25519.pub");FILE*f=fopen(kp,"r");if(f){if(!fgets(pub,sizeof pub,f))pub[0]=0;fclose(f);pub[strcspn(pub,"\r\n")]=0;}size_t a,b,d,e,g;char*qh=json_quote((unsigned char*)(ok?c.host:""),strlen(ok?c.host:""),&a),*qu=json_quote((unsigned char*)(ok?c.user:""),strlen(ok?c.user:""),&b),*qc=json_quote((unsigned char*)(ok?c.command:"codex"),strlen(ok?c.command:"codex"),&d),*qw=json_quote((unsigned char*)(ok?c.workdir:""),strlen(ok?c.workdir:""),&e),*qk=json_quote((unsigned char*)pub,strlen(pub),&g);size_t cap=a+b+d+e+g+256;char*body=malloc(cap);int n=snprintf(body,cap,"{\"ok\":true,\"configured\":%s,\"host\":%s,\"user\":%s,\"port\":%d,\"command\":%s,\"workdir\":%s,\"publicKey\":%s,\"running\":%s}\n",ok?"true":"false",qh,qu,ok?c.port:22,qc,qw,qk,codex_running?"true":"false");free(qh);free(qu);free(qc);free(qw);free(qk);reply(fd,200,"application/json",NULL,body,(size_t)n);free(body);}
static int mkdir_private(const char*p){if(mkdir(p,0700)<0&&errno!=EEXIST)return-1;return chmod(p,0700);}
static void codex_save(int fd,const char*body){char*h=json_string(body,"host",NULL),*u=json_string(body,"user",NULL),*co=json_string(body,"command",NULL),*wd=json_string(body,"workdir",NULL),*po=json_string(body,"port",NULL);int port=po?atoi(po):22;if(!codex_atom(h)||!codex_atom(u)||!codex_atom(co)||!codex_path_ok(wd)||port<1||port>65535){free(h);free(u);free(co);free(wd);free(po);json_error(fd,400,"invalid Codex connection settings");return;}char dir[PATH_MAX],p[PATH_MAX],tmp[PATH_MAX];const char*home=getenv("HOME");snprintf(dir,sizeof dir,"%s/.config",home);mkdir_private(dir);snprintf(dir,sizeof dir,"%s/.config/wisp",home);mkdir_private(dir);codex_path(p,"codex-web.conf");snprintf(tmp,sizeof tmp,"%s.tmp",p);FILE*f=fopen(tmp,"w");if(!f||fprintf(f,"host=%s\nuser=%s\nport=%d\ncommand=%s\nworkdir=%s\n",h,u,port,co,wd)<0||fclose(f)<0||chmod(tmp,0600)<0||rename(tmp,p)<0){if(f)fclose(f);unlink(tmp);json_error(fd,500,"could not save configuration");}else{const char*y="{\"ok\":true}\n";reply(fd,200,"application/json",NULL,y,strlen(y));}free(h);free(u);free(co);free(wd);free(po);}
