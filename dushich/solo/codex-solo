#!/usr/bin/env bash
set -euo pipefail

# Solo Dushich runs with Aria's Unix authority and a separate Codex home.
codex=/opt/noobia/dushich-codex/node_modules/.bin/codex
home=/noobia/dushich/solo/private/codex
[[ -x "$codex" ]] || { echo "Dushich Codex CLI is missing" >&2; exit 1; }
[[ -f "$home/config.toml" ]] || { echo "Solo Dushich config is missing" >&2; exit 1; }
[[ -r "$home/AGENTS.md" ]] || { echo "Solo Dushich instructions are missing" >&2; exit 1; }
/usr/bin/curl --fail --silent --max-time 3 http://127.0.0.1:11434/api/version >/dev/null || {
    echo "Local Ollama is unavailable" >&2; exit 1;
}

if [[ $# -gt 0 ]]; then
    [[ $# -eq 2 && "$1" == resume && "$2" =~ ^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$ ]] || {
        echo "Usage: codex-solo [resume SESSION_ID]" >&2; exit 2;
    }
fi

exec /usr/bin/env -i \
    HOME=/home/aria USER=aria LOGNAME=aria \
    CODEX_HOME="$home" \
    GIT_AUTHOR_NAME=Dushich GIT_AUTHOR_EMAIL=dushich@nexus.local \
    GIT_COMMITTER_NAME=Dushich GIT_COMMITTER_EMAIL=dushich@nexus.local \
    GIT_SSH_COMMAND='ssh -i /home/aria/.ssh/noobia_dushich_github -o IdentityAgent=none -o IdentitiesOnly=yes' \
    OLLAMA_HOST=http://127.0.0.1:11434 \
    PATH=/opt/noobia/dushich-codex/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
    TERM="${TERM:-xterm}" LANG="${LANG:-C.UTF-8}" \
    /bin/bash -c 'cd /noobia && exec /opt/noobia/dushich-codex/node_modules/.bin/codex --oss --local-provider ollama --model gpt-oss:20b --sandbox danger-full-access --ask-for-approval never "$@"' \
    dushich-solo "$@"
