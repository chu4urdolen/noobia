static void codex_keygen(int fd){const char*h=getenv("HOME");char dir[PATH_MAX],key[PATH_MAX];snprintf(dir,sizeof dir,"%s/.ssh",h);mkdir_private(dir);snprintf(key,sizeof key,"%s/.ssh/wisp_codex_ed25519",h);if(access(key,F_OK)==0){codex_status(fd);return;}pid_t p=fork();if(p==0){execlp("ssh-keygen","ssh-keygen","-q","-t","ed25519","-N","","-C","wisp-codex-relay","-f",key,(char*)NULL);_exit(127);}int st;waitpid(p,&st,0);if(!WIFEXITED(st)||WEXITSTATUS(st)){json_error(fd,500,"ssh-keygen failed");return;}codex_status(fd);}
static void codex_test(int fd){struct codex_config c;if(codex_load(&c)<0){json_error(fd,409,"configure Codex first");return;}int pp[2];if(pipe(pp)){json_error(fd,500,"pipe failed");return;}pid_t p=fork();if(p==0){dup2(pp[1],1);dup2(pp[1],2);close(pp[0]);char port[16],dest[400],key[PATH_MAX],remote[256];snprintf(port,sizeof port,"%d",c.port);snprintf(dest,sizeof dest,"%s@%s",c.user,c.host);snprintf(key,sizeof key,"%s/.ssh/wisp_codex_ed25519",getenv("HOME"));snprintf(remote,sizeof remote,"%s --version",c.command);execlp("ssh","ssh","-i",key,"-o","IdentitiesOnly=yes","-o","BatchMode=yes","-o","StrictHostKeyChecking=accept-new","-o","ConnectTimeout=8","-p",port,dest,remote,(char*)NULL);_exit(127);}close(pp[1]);char raw[2048];ssize_t n=read(pp[0],raw,sizeof raw-1);close(pp[0]);int st;waitpid(p,&st,0);if(n<0)n=0;raw[n]=0;size_t ql;char*q=json_quote((unsigned char*)raw,(size_t)n,&ql);char*b=malloc(ql+100);int z=snprintf(b,ql+100,"{\"ok\":%s,\"output\":%s}\n",WIFEXITED(st)&&!WEXITSTATUS(st)?"true":"false",q);free(q);reply(fd,WIFEXITED(st)&&!WEXITSTATUS(st)?200:409,"application/json",NULL,b,(size_t)z);free(b);}
