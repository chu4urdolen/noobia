#!/usr/bin/env bash
set -euo pipefail

codex=/opt/noobia/dushich-codex/node_modules/.bin/codex
helper_instructions=/noobia/dushich/coding/private/codex/AGENTS.md

if [[ ! -x "$codex" ]]; then
    echo "Dushich's Codex CLI is missing: $codex" >&2
    exit 1
fi
if [[ ! -r "$helper_instructions" ]]; then
    echo "Dushich helper instructions are missing: $helper_instructions" >&2
    exit 1
fi
if ! /usr/bin/curl --fail --silent --max-time 3 http://127.0.0.1:11434/api/version >/dev/null; then
    echo "Local Ollama is unavailable at 127.0.0.1:11434; refusing to start." >&2
    exit 1
fi

# Keep this launcher on the local model and its configured permission mode.
for arg in "$@"; do
    case "$arg" in
        --dangerously-*|--full-auto|--yolo|--remote*|--model*|--local-provider*|--profile*|--config*|--sandbox*|--permission-profile*|--ignore-user-config|--worktree|--search|--enable*|--disable*|--cd*|--add-dir*|--oss|-m*|-p*|-c*|-s*|-C*|-a*|-P*|--ask-for-approval*|--approve-for-me|cloud|mcp|plugin|login|logout|app-server|exec-server)
            echo "Unsupported Dushich option: $arg" >&2
            exit 2
            ;;
    esac
done

args=("$codex" --oss --local-provider ollama --model qwen3.8:27b)
if [[ "${1:-}" == task ]]; then
    shift
    args=(/usr/bin/python3 /usr/local/libexec/dushich-task.py)
elif [[ "${1:-}" == exec ]]; then
    shift
    args+=(exec)
fi
[[ "$(/usr/bin/id -un)" == "aria" ]] || {
    echo "Run Dushich from the aria account" >&2
    exit 1
}
if [[ $# -eq 0 && -t 0 && -t 1 && -z "${NOOBIA_DUSHICH_TMUX_PANE:-}" ]] && command -v tmux >/dev/null 2>&1; then
    session="noobia-dushich-$$"
    cols="$(tput cols 2>/dev/null || echo 100)"
    lines="$(tput lines 2>/dev/null || echo 24)"
    tmux -L dushich-clean new-session -d -x "$cols" -y "$lines" -s "$session" -n workshop -c /noobia \
        "exec env NOOBIA_DUSHICH_TMUX_PANE=1 /usr/local/bin/dushich"
    tmux -L dushich-clean split-window -h -l 18 -t "$session":0.0 -c /noobia \
        "exec /usr/bin/python3 /noobia/dushich/solo/avatar_pane.py --agent Dushich --tmux-socket dushich-clean --target-pane ${session}:0.0 --size 18"
    tmux -L dushich-clean set-hook -t "$session" client-attached "resize-pane -t ${session}:0.1 -x 18"
    tmux -L dushich-clean set-hook -t "$session" client-resized "resize-pane -t ${session}:0.1 -x 18"
    tmux -L dushich-clean set-hook -t "$session" window-resized "resize-pane -t ${session}:0.1 -x 18"
    tmux -L dushich-clean set-window-option -t "$session":0 pane-border-status top
    tmux -L dushich-clean set-window-option -t "$session":0 pane-border-format ' #{pane_title} '
    tmux -L dushich-clean select-pane -t "$session":0.0 -T 'Dushich • Codex'
    tmux -L dushich-clean select-pane -t "$session":0.1 -T 'Dushich • Status'
    tmux -L dushich-clean select-pane -t "$session":0.0
    exec tmux -L dushich-clean attach-session -t "$session"
fi
exec /usr/bin/env -i \
    HOME=/home/aria USER=aria LOGNAME=aria \
    CODEX_HOME=/noobia/dushich/coding/private/codex \
    GIT_AUTHOR_NAME=Dushich GIT_AUTHOR_EMAIL=dushich@nexus.local \
    GIT_COMMITTER_NAME=Dushich GIT_COMMITTER_EMAIL=dushich@nexus.local \
    OLLAMA_HOST=http://127.0.0.1:11434 \
    GIT_SSH_COMMAND='ssh -i /home/aria/.ssh/noobia_dushich_github -o IdentityAgent=none -o IdentitiesOnly=yes' \
    PATH=/opt/noobia/dushich-codex/node_modules/.bin:/usr/local/bin:/usr/bin:/bin \
    TERM="${TERM:-xterm}" LANG="${LANG:-C.UTF-8}" \
    /bin/bash -c 'cd /noobia && exec "$@"' \
    dushich-launcher "${args[@]}" "$@"
