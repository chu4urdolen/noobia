#!/bin/sh
# Current DHCP lease; rediscover through the pinned V19 collector after reboot.
exec ssh -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes \
    -o GlobalKnownHostsFile=/dev/null -o HostKeyAlias=lynx \
    -o UserKnownHostsFile=/noobia/lynx/secrets/lynx_known_hosts \
    -o ConnectTimeout=5 -i /noobia/lynx/secrets/nexus_lynx_ed25519 \
    root@192.168.100.9 "$@"
