# Creates a photograph, a one-second WAV, and a two-frame MJPEG on SD.
PING
LOAD 200064000000
RUN
STATUS
PING
LOAD 01000100000020017a00010000
RUN
STATUS
PING
LOAD 01000100000001010200000020026b0002000100
RUN
STATUS
PING
CALL WIFI_CONNECT 10000
CALL WIFI_STATUS
CALL WIFI_SCAN
CALL WIFI_RSSI 0
PING
CALL BLE_SCAN 2
CALL BLE_STATUS
PING
CALL_TEXT SD_LIST /audio
CALL_TEXT SD_LIST /video
CALL_TEXT VM_LIST_SAVED
