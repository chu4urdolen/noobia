#!/usr/bin/env bash
set -euo pipefail

TOOLS=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
IRIS_ROOT=$(cd -- "$TOOLS/.." && pwd)
CONFIG=${IRIS_CONFIG_FILE:-"$TOOLS/iris-tools.conf"}
OPT_STATE=
OPT_PROGRAMS=
OPT_UART=

while (( $# )); do
  case $1 in
    --config) CONFIG=$2; shift 2 ;;
    --state) OPT_STATE=$2; shift 2 ;;
    --programs) OPT_PROGRAMS=$2; shift 2 ;;
    --uart-device) OPT_UART=$2; shift 2 ;;
    --help|-h) set -- help; break ;;
    --) shift; break ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
[[ ! -r $CONFIG ]] || source "$CONFIG"
export IRIS_CONFIG_FILE=$CONFIG
STATE=${OPT_STATE:-${IRIS_STATE_FILE:-"$IRIS_ROOT/run/ble-bridge.state"}}
PROGRAMS=${OPT_PROGRAMS:-${IRIS_PROGRAMS_DIR:-"$IRIS_ROOT/programs"}}
COMMON_PROGRAMS=${IRIS_COMMON_PROGRAMS_DIR:-"$IRIS_ROOT/../esp/common/programs"}
UART_DEVICE=${OPT_UART:-${IRIS_UART_DEVICE:-/dev/ttyUSB0}}
AUTO_BRIDGE=${IRIS_AUTO_BRIDGE:-1}
BRIDGE_WAIT_SECONDS=${IRIS_BRIDGE_WAIT_SECONDS:-30}
BRIDGE_UNIT=${IRIS_BRIDGE_SYSTEMD_UNIT:-iris-ble-bridge}
BLE_PEER=${IRIS_BLE_PEER_MAC:-}

usage() {
  echo "usage:"
  echo "  irisctl [--config FILE] [--state FILE] [--programs DIR] [--uart-device DEVICE] COMMAND"
  echo "  irisctl bridge"
  echo "  irisctl status"
  echo "  irisctl ping | info | caps | capture | scan"
  echo "  irisctl time-now | time-reset"
  echo "  irisctl rssi-on | rssi-off | watch"
  echo "  irisctl wifi-connect [TIMEOUT_MS] | wifi-disconnect | wifi-status"
  echo "  irisctl wifi-set SSID PASSWORD"
  echo "  irisctl ble-scan [SECONDS] | ble-peer MAC | ble-status"
  echo "  irisctl audio-record [SECONDS] | video-record [SECONDS] [FPS]"
  echo "  irisctl dht-read [0=temperature|1=humidity]"
  echo "  irisctl light-read [SAMPLES]"
  echo "  irisctl ultrasonic-read [SAMPLES] [TIMEOUT_US]"
  echo "  irisctl ir-send [MILLISECONDS] [HZ] | ir-read [MILLISECONDS] | ir-test [BURSTS]"
  echo "  irisctl gpio-audit [PAGE] | gpio-inspect PIN | gpio-pull-test PIN"
  echo "  irisctl mic-level | led RED GREEN BLUE | led-off | signal-led 0|1 | external-led 0|2 0|1"
  echo "  irisctl programs | vm-load NAME | vm-run | vm-stop | vm-reset | vm-status"
  echo "  irisctl thread-start NAME | thread-stop | thread-status"
  echo "  irisctl sequence-set SLOT MS FUNCTION BITS [ARGS...]"
  echo "  irisctl sequence-start [0|1] | sequence-stop | sequence-status | sequence-clear [SLOT]"
  echo "  irisctl sequence-pop SLOT | sequence-queue-size SLOT | sequence-queue-clear SLOT"
  echo "  irisctl sequence-busy SLOT"
  echo "  irisctl blue-blink [0|1] | police-sequence [0|1] | police-lights | police-stop"
  echo "  irisctl ultrasonic-change-start [MM] [INTERVAL_MS]"
  echo "  irisctl ultrasonic-change-stop | ultrasonic-change-status"
  echo "  irisctl ultrasonic-change-pop | ultrasonic-change-poll | motion-police | sensor-police"
  echo "  irisctl light-change-start [DELTA] [INTERVAL_MS]"
  echo "  irisctl light-change-stop | light-change-status | light-change-pop | light-change-poll"
  echo "  irisctl mic-rise-start [RATIO_PERCENT] [MIN_RMS] | mic-rise-stop | mic-rise-status"
  echo "  irisctl mic-rise-pop | mic-rise-poll | sound-police | all-police"
  echo "  irisctl camera-sequence [0|1] | ir-transmit-sequence [0|1]"
  echo "  irisctl rssi-scan-start [DURATION_MS] [INTERVAL_MS]"
  echo "  irisctl rssi-scan-stop | rssi-scan-status | rssi-scan-pop | rssi-scan-poll"
  echo "  irisctl ir-scan-start [DURATION_MS] [INTERVAL_MS]"
  echo "  irisctl ir-scan-stop | ir-scan-status | ir-scan-pop | ir-scan-poll"
  echo "  irisctl env-start [INTERVAL_MS] | env-stop | env-status | env-pop | env-poll"
  echo "  irisctl env-temperature | env-humidity"
  echo "  irisctl vm-save NAME | vm-load-saved NAME | vm-list-saved | vm-delete-saved NAME"
  echo "  irisctl vm-last-status | vm-last-clear"
  echo "  irisctl sd-list [PATH] | sd-delete PATH | capture-delete SEQUENCE"
  echo "  irisctl ble REQUEST_ID COMMAND [ARGS...]"
  echo "  irisctl fetch SEQUENCE OUTPUT.jpg"
  echo "  irisctl uart REQUEST_ID COMMAND [ARGS...]"
  echo "  Commands can also be piped to: noobctl_batch DEVICE"
}

hex_text() {
  printf "%s" "$1" | xxd -p -c 256 | tr -d "\n"
}

read_bridge_state() {
  unset pid fd log
  [[ -r $STATE ]] && source "$STATE"
}

bridge_alive() {
  read_bridge_state
  [[ ${pid:-} =~ ^[0-9]+$ && -d /proc/$pid ]]
}

bridge_ready() {
  read_bridge_state
  [[ ${pid:-} =~ ^[0-9]+$ && -d /proc/$pid &&
     ${fd:-} =~ ^[0-9]+$ && -e /proc/$pid/fd/$fd ]]
}

start_bridge() {
  local state_dir
  state_dir=$(dirname -- "$STATE")
  mkdir -p "$state_dir"
  [[ $BRIDGE_UNIT =~ ^[a-zA-Z0-9_.@-]+$ ]] ||
    { echo "IRIS_BRIDGE_SYSTEMD_UNIT is invalid" >&2; return 2; }
  systemd-run --user --quiet --collect --unit "$BRIDGE_UNIT" \
    --property Restart=on-failure --property RestartSec=2s \
    "$TOOLS/nexus_ble_bridge.sh" --config "$CONFIG" --state "$STATE"
}

nudge_iris_ble() {
  [[ -n $BLE_PEER && -c $UART_DEVICE && -x $TOOLS/noobctl ]] || return 0
  [[ $BLE_PEER =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] || return 0
  NOOB_SERIAL_SETTLE_MS=1500 NOOB_SERIAL_TIMEOUT_MS=4000 \
    "$TOOLS/noobctl" "$UART_DEVICE" "bridge$$" \
    CALL_TEXT BLE_PEER_SET "$BLE_PEER" >/dev/null 2>&1 || true
}

load_bridge() {
  bridge_ready && return 0
  [[ $AUTO_BRIDGE == 1 ]] ||
    { echo "BLE bridge is unavailable and automatic startup is disabled" >&2; exit 1; }
  [[ $BRIDGE_WAIT_SECONDS =~ ^[1-9][0-9]*$ ]] ||
    { echo "IRIS_BRIDGE_WAIT_SECONDS must be a positive integer" >&2; exit 2; }

  bridge_alive || start_bridge
  nudge_iris_ble
  for (( attempt=0; attempt < BRIDGE_WAIT_SECONDS * 10; ++attempt )); do
    bridge_ready && return 0
    sleep 0.1
  done

  if bridge_alive; then
    echo "BLE bridge is running, but Iris did not connect within ${BRIDGE_WAIT_SECONDS}s" >&2
  else
    echo "BLE bridge failed to start; inspect: journalctl --user -u $BRIDGE_UNIT" >&2
  fi
  exit 1
}

case ${1:-} in
  bridge)
    exec "$TOOLS/nexus_ble_bridge.sh" --config "$CONFIG" --state "$STATE"
    ;;
  status)
    if bridge_ready; then
      echo "bridge=connected pid=$pid notify_fd=$fd log=${log:-unknown}"
      exit 0
    fi
    if bridge_alive; then
      echo "bridge=waiting pid=$pid notify_fd=waiting log=${log:-unknown}"
      exit 0
    fi
    echo "bridge=stopped"
    ;;
  ping|info|caps)
    command=${1^^}
    exec "$0" ble "ctl$$" "$command"
    ;;
  capture)
    exec "$0" ble "ctl$$" CALL CAMERA_CAPTURE
    ;;
  scan)
    exec "$0" ble "ctl$$" CALL WIFI_SCAN
    ;;
  time-now)
    exec "$0" ble "ctl$$" CALL TIME_NOW
    ;;
  time-reset)
    exec "$0" ble "ctl$$" CALL TIME_RESET
    ;;
  rssi-on)
    exec "$0" ble "ctl$$" CALL RSSI_ON
    ;;
  rssi-off)
    exec "$0" ble "ctl$$" CALL RSSI_OFF
    ;;
  wifi-connect)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL WIFI_CONNECT "${2:-15000}"
    ;;
  wifi-disconnect)
    exec "$0" ble "ctl$$" CALL WIFI_DISCONNECT
    ;;
  wifi-status)
    exec "$0" ble "ctl$$" CALL WIFI_STATUS
    ;;
  wifi-set)
    (( $# == 3 )) || { usage >&2; exit 2; }
    ssid_hex=$(hex_text "$2")
    password_hex=$(hex_text "$3")
    exec "$0" ble "ctl$$" CALL_TEXT WIFI_CREDENTIALS_SET "$ssid_hex" "$password_hex"
    ;;
  ble-scan)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL BLE_SCAN "${2:-3}"
    ;;
  ble-peer)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL_TEXT BLE_PEER_SET "$2"
    ;;
  ble-status)
    exec "$0" ble "ctl$$" CALL BLE_STATUS
    ;;
  dht-read)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL TEMP_HUMIDITY_READ "${2:-0}"
    ;;
  light-read)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL LIGHT_READ "${2:-16}"
    ;;
  ultrasonic-read)
    (( $# <= 3 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL ULTRASONIC_READ "${2:-3}" "${3:-30000}"
    ;;
  ir-send)
    (( $# <= 3 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL IR_SEND "${2:-10}" "${3:-38000}"
    ;;
  ir-read)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL IR_READ "${2:-100}"
    ;;
  ir-test)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL IR_LOOPBACK "${2:-20}"
    ;;
  gpio-audit)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL GPIO_AUDIT "${2:-0}"
    ;;
  gpio-inspect)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL GPIO_INSPECT "$2"
    ;;
  gpio-pull-test)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL GPIO_PULL_TEST "$2"
    ;;
  audio-record)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL AUDIO_RECORD "${2:-1}"
    ;;
  video-record)
    (( $# <= 3 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL CAMERA_VIDEO "${2:-3}" "${3:-5}"
    ;;
  mic-level)
    exec "$0" ble "ctl$$" CALL MIC_LEVEL
    ;;
  led)
    (( $# == 4 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL LED_RGB "$2" "$3" "$4"
    ;;
  led-off)
    exec "$0" ble "ctl$$" CALL LED_RGB 0 0 0
    ;;
  signal-led)
    (( $# == 2 && ($2 == 0 || $2 == 1) )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL LED_SIGNAL "$2"
    ;;
  external-led)
    (( $# == 3 && ($2 == 0 || $2 == 2) && ($3 == 0 || $3 == 1) )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL LED_EXTERNAL "$2" "$3"
    ;;
  police-lights)
    exec "$0" thread-start police_lights
    ;;
  blue-blink)
    (( $# <= 2 )) && [[ ${2:-0} =~ ^[01]$ ]] || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL BLUE_BLINK_SEQUENCE "${2:-0}"
    ;;
  police-sequence)
    (( $# <= 2 )) && [[ ${2:-0} =~ ^[01]$ ]] || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL POLICE_SEQUENCE "${2:-0}"
    ;;
  police-stop)
    "$0" sequence-stop || true
    "$0" vm-stop || true
    "$0" external-led 2 0 || true
    exec "$0" external-led 0 0
    ;;
  programs)
    for program in "$COMMON_PROGRAMS"/*.hex "$PROGRAMS"/*.hex; do
      [[ -e $program ]] && basename "$program" .hex
    done | sort -u
    ;;
  vm-load)
    (( $# == 2 )) || { usage >&2; exit 2; }
    [[ $2 =~ ^[a-z0-9_-]+$ ]] || { echo "invalid VM program name: $2" >&2; exit 2; }
    program="$PROGRAMS/$2.hex"
    [[ -r $program ]] || program="$PROGRAMS/vm_$2.hex"
    [[ -r $program ]] || program="$COMMON_PROGRAMS/$2.hex"
    [[ -r $program ]] || { echo "unknown VM program: $2" >&2; exit 2; }
    hex=$(tr -d [:space:] < "$program")
    exec "$0" ble "ctl$$" LOAD "$hex"
    ;;
  vm-run)
    exec "$0" ble "ctl$$" RUN
    ;;
  vm-stop)
    exec "$0" ble "ctl$$" STOP
    ;;
  vm-reset)
    exec "$0" ble "ctl$$" RESET_VM
    ;;
  vm-status)
    exec "$0" ble "ctl$$" STATUS
    ;;
  thread-start)
    (( $# == 2 )) || { usage >&2; exit 2; }
    "$0" vm-load "$2"
    exec "$0" ble "ctl$$" START_THREAD
    ;;
  thread-stop)
    exec "$0" ble "ctl$$" STOP_THREAD
    ;;
  thread-status)
    exec "$0" ble "ctl$$" THREAD_STATUS
    ;;
  sequence-set)
    (( $# >= 5 )) || { usage >&2; exit 2; }
    shift
    exec "$0" ble "ctl$$" CALL_TEXT SEQUENCE_SET "$@"
    ;;
  sequence-start)
    (( $# <= 2 )) && [[ ${2:-0} =~ ^[01]$ ]] || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL SEQUENCE_START "${2:-0}"
    ;;
  sequence-stop)
    exec "$0" ble "ctl$$" CALL SEQUENCE_STOP
    ;;
  sequence-status)
    exec "$0" ble "ctl$$" CALL SEQUENCE_STATUS
    ;;
  sequence-clear)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    if (( $# == 2 )); then
      exec "$0" ble "ctl$$" CALL SEQUENCE_CLEAR "$2"
    fi
    exec "$0" ble "ctl$$" CALL SEQUENCE_CLEAR
    ;;
  sequence-pop)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL SEQUENCE_POP "$2"
    ;;
  sequence-queue-size)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL SEQUENCE_QUEUE_SIZE "$2"
    ;;
  sequence-queue-clear)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL SEQUENCE_QUEUE_CLEAR "$2"
    ;;
  sequence-busy)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL SEQUENCE_BUSY "$2"
    ;;
  ultrasonic-change-start)
    (( $# <= 3 )) || { usage >&2; exit 2; }
    if (( $# == 3 )); then
      exec "$0" ble "ctl$$" CALL ULTRASONIC_CHANGE_START "$2" "$3"
    elif (( $# == 2 )); then
      exec "$0" ble "ctl$$" CALL ULTRASONIC_CHANGE_START "$2"
    fi
    exec "$0" ble "ctl$$" CALL ULTRASONIC_CHANGE_START
    ;;
  ultrasonic-change-stop)
    exec "$0" ble "ctl$$" CALL ULTRASONIC_CHANGE_STOP
    ;;
  ultrasonic-change-status)
    exec "$0" ble "ctl$$" CALL ULTRASONIC_CHANGE_STATUS
    ;;
  ultrasonic-change-pop)
    exec "$0" ble "ctl$$" CALL ULTRASONIC_CHANGE_POP
    ;;
  ultrasonic-change-poll)
    exec "$0" ble "ctl$$" CALL ULTRASONIC_CHANGE_POLL
    ;;
  motion-police)
    exec "$0" thread-start police_on_ultrasonic_change
    ;;
  sensor-police)
    exec "$0" thread-start police_on_sensor_change
    ;;
  light-change-start)
    (( $# <= 3 )) || { usage >&2; exit 2; }
    if (( $# == 3 )); then
      exec "$0" ble "ctl$$" CALL LIGHT_CHANGE_START "$2" "$3"
    elif (( $# == 2 )); then
      exec "$0" ble "ctl$$" CALL LIGHT_CHANGE_START "$2"
    fi
    exec "$0" ble "ctl$$" CALL LIGHT_CHANGE_START
    ;;
  light-change-stop)
    exec "$0" ble "ctl$$" CALL LIGHT_CHANGE_STOP
    ;;
  light-change-status)
    exec "$0" ble "ctl$$" CALL LIGHT_CHANGE_STATUS
    ;;
  light-change-pop)
    exec "$0" ble "ctl$$" CALL LIGHT_CHANGE_POP
    ;;
  light-change-poll)
    exec "$0" ble "ctl$$" CALL LIGHT_CHANGE_POLL
    ;;
  mic-rise-start)
    (( $# <= 3 )) || { usage >&2; exit 2; }
    if (( $# == 3 )); then
      exec "$0" ble "ctl$$" CALL MIC_RISE_START "$2" "$3"
    elif (( $# == 2 )); then
      exec "$0" ble "ctl$$" CALL MIC_RISE_START "$2"
    fi
    exec "$0" ble "ctl$$" CALL MIC_RISE_START
    ;;
  mic-rise-stop)
    exec "$0" ble "ctl$$" CALL MIC_RISE_STOP
    ;;
  mic-rise-status)
    exec "$0" ble "ctl$$" CALL MIC_RISE_STATUS
    ;;
  mic-rise-pop)
    exec "$0" ble "ctl$$" CALL MIC_RISE_POP
    ;;
  mic-rise-poll)
    exec "$0" ble "ctl$$" CALL MIC_RISE_POLL
    ;;
  sound-police)
    exec "$0" thread-start police_on_loudness_rise
    ;;
  all-police)
    exec "$0" thread-start police_on_any_change
    ;;
  camera-sequence)
    (( $# <= 2 )) && [[ ${2:-0} =~ ^[01]$ ]] || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL CAMERA_SEQUENCE "${2:-0}"
    ;;
  ir-transmit-sequence)
    (( $# <= 2 )) && [[ ${2:-0} =~ ^[01]$ ]] || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL IR_SEQUENCE "${2:-0}"
    ;;
  rssi-scan-start)
    (( $# <= 3 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL RSSI_THREAD_START "${2:-10000}" "${3:-1000}"
    ;;
  rssi-scan-stop)
    exec "$0" ble "ctl$$" CALL RSSI_THREAD_STOP
    ;;
  rssi-scan-status)
    exec "$0" ble "ctl$$" CALL RSSI_THREAD_STATUS
    ;;
  rssi-scan-pop)
    exec "$0" ble "ctl$$" CALL RSSI_THREAD_POP
    ;;
  rssi-scan-poll)
    exec "$0" ble "ctl$$" CALL RSSI_THREAD_POLL
    ;;
  ir-scan-start)
    (( $# <= 3 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL IR_THREAD_START "${2:-10000}" "${3:-1000}"
    ;;
  ir-scan-stop)
    exec "$0" ble "ctl$$" CALL IR_THREAD_STOP
    ;;
  ir-scan-status)
    exec "$0" ble "ctl$$" CALL IR_THREAD_STATUS
    ;;
  ir-scan-pop)
    exec "$0" ble "ctl$$" CALL IR_THREAD_POP
    ;;
  ir-scan-poll)
    exec "$0" ble "ctl$$" CALL IR_THREAD_POLL
    ;;
  env-start)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL ENV_THREAD_START 0 "${2:-2500}"
    ;;
  env-stop)
    exec "$0" ble "ctl$$" CALL ENV_THREAD_STOP
    ;;
  env-status)
    exec "$0" ble "ctl$$" CALL ENV_THREAD_STATUS
    ;;
  env-pop)
    exec "$0" ble "ctl$$" CALL ENV_THREAD_POP
    ;;
  env-poll)
    exec "$0" ble "ctl$$" CALL ENV_THREAD_POLL
    ;;
  env-temperature)
    exec "$0" ble "ctl$$" CALL ENV_TEMPERATURE
    ;;
  env-humidity)
    exec "$0" ble "ctl$$" CALL ENV_HUMIDITY
    ;;
  vm-save)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL_TEXT VM_SAVE "$2"
    ;;
  vm-load-saved)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL_TEXT VM_LOAD_SAVED "$2"
    ;;
  vm-list-saved)
    exec "$0" ble "ctl$$" CALL_TEXT VM_LIST_SAVED
    ;;
  vm-delete-saved)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL_TEXT VM_DELETE_SAVED "$2"
    ;;
  vm-last-status)
    exec "$0" ble "ctl$$" CALL VM_LAST_STATUS
    ;;
  vm-last-clear)
    exec "$0" ble "ctl$$" CALL VM_LAST_CLEAR
    ;;
  sd-list)
    (( $# <= 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL_TEXT SD_LIST "${2:-/}"
    ;;
  sd-delete)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL_TEXT SD_DELETE "$2"
    ;;
  capture-delete)
    (( $# == 2 )) || { usage >&2; exit 2; }
    exec "$0" ble "ctl$$" CALL CAPTURE_DELETE "$2"
    ;;
  watch)
    load_bridge
    payload=
    active=
    tail -n 0 -F "$log" | while IFS= read -r line; do
      if [[ $line == *"WriteValue:"* ]]; then
        [[ -n $active && -n $payload ]] && printf "%s\n" "$payload"
        payload=; active=1
        continue
      fi
      [[ -n $active && $line == *"#   "* ]] || continue
      dump=${line#*#   }
      # BlueZ reserves 48 columns for the hex side of its dump. Restrict
      # parsing to that field so SSID/channel text cannot resemble a byte.
      dump=${dump:0:48}
      hex=
      count=0
      for token in $dump; do
        [[ $token =~ ^[0-9a-f][0-9a-f]$ ]] || break
        hex+="$token"; count=$((count + 1))
        (( count == 16 )) && break
      done
      payload+="$(printf "%s" "$hex" | xxd -r -p)"
      if (( count < 16 )); then
        printf "%s\n" "$payload"
        payload=; active=
      fi
    done
    ;;
  ble)
    (( $# >= 3 )) || { usage >&2; exit 2; }
    load_bridge
    shift
    request_id=$1
    frame="NRP/1 $*"
    before=$(stat -c %s "$log")
    pkexec "$TOOLS/noob_ble_fd" "$pid" "$fd" "$frame" >/dev/null
    scratch=$(mktemp)
    trap "rm -f \"$scratch\"" EXIT
    previous_size=-1
    for _ in $(seq 1 100); do
      tail -c "+$((before + 1))" "$log" > "$scratch"
      current_size=$(stat -c %s "$scratch")
      hex=$(sed -n "s/.*#   \\(\\([0-9a-f][0-9a-f] \\)\\{1,16\\}\\).*/\\1/p" \
        "$scratch" | tr -d " \\r\\n")
      response=$(printf "%s" "$hex" | xxd -r -p 2>/dev/null || true)
      if [[ $response == *"NRP/1 $request_id "* &&
            $current_size == $previous_size ]]; then
        response="NRP/1 $request_id ${response#*"NRP/1 $request_id "}"
        printf "%s\n" "$response"
        [[ $response != "NRP/1 $request_id ERR "* ]] || exit 1
        exit 0
      fi
      previous_size=$current_size
      sleep 0.1
    done
    echo "timed out waiting for Iris reply" >&2
    exit 1
    ;;
  fetch)
    (( $# == 3 )) || { usage >&2; exit 2; }
    load_bridge
    export NOOB_BLE_LOG=$log
    exec "$TOOLS/iris_ble_fetch.sh" "$pid" "$fd" "$2" "$3"
    ;;
  uart)
    (( $# >= 3 )) || { usage >&2; exit 2; }
    shift
    printf -v uart_command '%q ' "$TOOLS/noobctl" "$UART_DEVICE" "$@"
    exec sg dialout -c "$uart_command"
    ;;
  help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
